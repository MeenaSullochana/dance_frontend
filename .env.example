# Copy values into .env.development / .env.production
# Vite only exposes variables that start with VITE_

VITE_FRONTEND_URL=http://localhost:5173
VITE_BACKEND_URL=http://127.0.0.1:7000
VITE_API_URL=/api

# The website picks the API from the current host:
# localhost            → local API
# *.netlify.app        → Render, then live if Render is down
# dod.senatespace.in   → live    https://backdod.senatespace.in
# Set VITE_BACKEND_RENDER_URL to your Render service URL.

VITE_BACKEND_LIVE_URL=https://backdod.senatespace.in
VITE_BACKEND_RENDER_URL=https://dance-backend-3kwj.onrender.com
