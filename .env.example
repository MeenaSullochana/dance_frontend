# Copy values into .env.development / .env.production
# Vite only exposes variables that start with VITE_

VITE_FRONTEND_URL=http://localhost:5173
VITE_BACKEND_URL=http://127.0.0.1:7000
# Local: /api is proxied by Vite to the backend (prevents CORS / reach errors)
VITE_API_URL=/api

# Production (set these before building for the live host):
# VITE_FRONTEND_URL=https://dod.senatespace.in
# VITE_BACKEND_URL=https://backdod.senatespace.in
# VITE_API_URL=https://backdod.senatespace.in/api
